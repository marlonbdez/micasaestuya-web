{
  "name": "micasaestuya",
  "version": "1.0.0-beta",
  "description": "micasaestuya website",
  "private": true,
  "scripts": {
    "test:unit": "vitest",
    "test:unit:headless": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e:open": "cypress open",
    "test:e2e:run": "cypress run --browser chrome",
    "test:e2e": "npm-run-all -pr dev test:e2e:open",
    "test:e2e:headless": "npm-run-all -pr serve test:e2e:run",
    "test:e2e:parallel": "run-p --race serve \"test:e2e:run -- --spec {1}\" --",
    "lint": "npm-run-all -p lint:js lint:prettier",
    "lint:js": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "lint:js:fix": "eslint --ext \".ts,.vue\" --ignore-path .gitignore . --fix",
    "lint:prettier": "prettier --check . --ignore-path .gitignore",
    "lint:prettier:fix": "prettier --write --list-different .",
    "lint:fix": "npm-run-all -p lint:prettier:fix lint:js:fix",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "serve": "nuxt start",
    "postinstall": "nuxt prepare",
    "prepare": "npx husky install"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.12.1",
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@pinia/testing": "^0.1.3",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^1.5.0",
    "@vue/test-utils": "^2.4.5",
    "cypress": "^13.4.0",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-formatter-gitlab": "^5.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vitest": "^0.3.26",
    "husky": "^8.0.3",
    "jsdom": "^24.0.0",
    "msw": "^2.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "sass": "^1.62.1",
    "typescript": "^5.1.6",
    "vitest": "^1.5.0",
    "wait-for-expect": "^3.0.2"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^3.3.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@nuxtjs/i18n": "^8.5.6",
    "@pinia/nuxt": "^1.0.2",
    "@sentry/nuxt": "^9.0.0",
    "@vee-validate/nuxt": "^4.11.6",
    "@vee-validate/yup": "^4.11.6",
    "click-outside-vue3": "^4.0.1",
    "nuxt": "^3.14.1592",
    "nuxt-icons": "^3.2.1",
    "ohmyfetch": "^0.4.21",
    "pinia": "^2.1.7",
    "yup": "^1.2.0"
  },
  "overrides": {
    "vue": "latest"
  }
}
